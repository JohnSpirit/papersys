# 文献调研系统 secret 配置模板（3.11.2-open）
# 复制为 .env 并填入真实值。只读项目根目录 .env；容器部署用 Compose
# env_file 注入同名环境变量，.env 不会进入镜像。
# 检查就绪：paper config check / paper doctor

# MinerU PDF 解析（https://mineru.net；默认 mode="cloud" 时需要）
MINERU_TOKEN=

# 翻译/总结 LLM（OpenAI Chat Completions 兼容端点；端点与模型名在 config.toml [llm]）
# 任何兼容提供方均可：Volces ark / DeepSeek / Kimi / OpenRouter / vLLM / Ollama
LLM_API_KEY=

# Fireworks 托管检索（嵌入 qwen3-embedding-8b / 精排 qwen3-reranker-8b，见 config.toml [retrieval]）
# 必须使用开通了上述两个模型配额的 Fireworks key。
FIREWORKS_API_KEY=
# 可选覆盖：分别为嵌入/精排指定独立 key（缺省走 FIREWORKS_API_KEY -> ARK_API_KEY 回退链）
BP_EMBED_API_KEY=
BP_RERANK_API_KEY=
ARK_API_KEY=

# Semantic Scholar 搜索/引用（https://www.semanticscholar.org）
SEMANTIC_SCHOLAR_API_KEY=

# Sciverse 语义检索
SCIVERSE_API_TOKEN=

# OpenAlex 元数据富化/搜索/引文（https://openalex.org）
OPENALEX_API_KEY=

# ── 非敏感运行配置（也可直接写在 Compose 的 environment 段）──
# 统一数据根目录（容器内固定 /data，一般无需修改）
#PAPER_DATA_DIR=/data
# 非回环监听的显式允许（无登录体系，容器监听 0.0.0.0 时必须为 1）
#PAPER_ALLOW_REMOTE=1
# 指定配置文件位置（默认 <项目根>/config.toml）
#PAPER_CONFIG_PATH=
