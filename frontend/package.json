  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assert-build-base.mjs && tsc -b && vite build",
    "build:prod": "tsc -b && VITE_BASE_PATH=/papersys/ vite build",
    "build:verify": "tsc -b && vite build --outDir dist-verify",
